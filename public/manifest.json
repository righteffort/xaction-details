{
  "manifest_version": 3,
  "name": "Xaction Details",
  "version": "0.0.1",
  "message_serialization": "structured_clone",
  "key": "",
  "description": "Transaction Details Extension",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "permissions": ["alarms", "declarativeContent", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Xaction Details"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
