{
  "name": "Xaction Details",
  "description": "Transaction Details Extension",
  "version": "0.0.1",
  "manifest_version": 3,
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Xaction Details"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.chase.com/*"],
      "js": ["src/chaseContent.js"]
    },
    {
      "matches": ["https://*.amazon.com/*"],
      "js": ["src/amazonContent.js"]
    }
  ]
}
